# Server-side reads from Server Components (internal URL is fine)
API_URL=http://localhost:4000/api
# Browser calls — must be reachable from the user's browser. Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Dev only: hostnames besides localhost that may use the dev server (e.g. Tailscale)
ALLOWED_DEV_ORIGINS=
