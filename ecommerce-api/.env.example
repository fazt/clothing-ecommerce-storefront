DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ecommerce?schema=public"
PORT=4000
JWT_SECRET="dev-change-me-in-production"
JWT_EXPIRES_IN="7d"

# Browser origins allowed to call the API with credentials (comma-separated)
CORS_ORIGINS="http://localhost:3000"
# Parent domain shared by web and API in production (e.g. ecommerce-clothes.lat),
# so the web app can read the auth cookie the API sets. Leave empty locally.
COOKIE_DOMAIN=""
PAYPAL_CLIENT_ID="sandbox-client-id-placeholder"
PAYPAL_CLIENT_SECRET="sandbox-client-secret-placeholder"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
PAYPAL_RETURN_URL="http://localhost:3000/checkout/return"
PAYPAL_CANCEL_URL="http://localhost:3000/checkout/cancel"

# Email (Resend)
RESEND_API_KEY="re_placeholder-change-me"
RESEND_FROM="onboarding@resend.dev"
APP_NAME="Atelier"
RESET_PASSWORD_URL="http://localhost:3000/reset-password"

# Storage (DigitalOcean Spaces, S3-compatible)
DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACES_REGION="nyc3"
DO_SPACES_BUCKET="my-bucket-placeholder"
DO_SPACES_KEY="do-access-key-placeholder"
DO_SPACES_SECRET="do-secret-placeholder"
DO_SPACES_CDN_ENDPOINT=""
