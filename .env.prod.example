# cp .env.prod.example .env.prod   (NUNCA lo subas: el repo es público)
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# URL pública (sin barra final). Con HTTPS delante, usa https://tu-dominio.com
PUBLIC_URL=http://127.0.0.1:8126
WEB_PORT=8126

POSTGRES_USER=atelier
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=atelier

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
# false solo si sirves por HTTP plano (demo local): con true el navegador no guarda la cookie sin HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

APP_NAME=Atelier
CURRENCY=USD
ORDER_RESERVATION_MINUTES=30
LOG_LEVEL=info
# true = carga los datos de demo en cada arranque (borra pedidos y catálogo). Solo para demos.
SEED_ON_START=false

# Pagos: cada pasarela se activa solo si sus variables están definidas.
# La simulada queda APAGADA; enciéndela solo en una demo pública sin cobros reales.
PAYMENTS_SIMULATED_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM=Atelier <onboarding@resend.dev>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# local (volumen) o spaces (DigitalOcean Spaces)
STORAGE_DRIVER=local
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN_ENDPOINT=
# Hosts extra de imágenes para next/image (p. ej. el CDN de Spaces)
IMAGE_HOSTS=
