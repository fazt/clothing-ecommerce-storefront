# cp web/.env.example web/.env.local
# Lecturas desde Server Components (puede ser una URL interna, p. ej. http://api:4057/api en Docker).
API_URL=http://127.0.0.1:4057/api
# Llamadas desde el navegador: se incrusta en el bundle al compilar.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4057/api
# URL pública de la tienda (SEO: metadataBase, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5226
# Hosts de imágenes extra para next/image (separados por coma), p. ej. el CDN de Spaces.
IMAGE_HOSTS=
# Solo dev: hosts extra que pueden usar el dev server (p. ej. Tailscale).
ALLOWED_DEV_ORIGINS=
