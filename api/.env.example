DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ecommerce?schema=public"
# Defaults to 3000 in code when unset; keep 4000 locally so it does not clash with the web app
PORT=4000
JWT_SECRET="dev-change-me-in-production"
JWT_EXPIRES_IN="7d"
# NODE_ENV="production" marks the auth and OAuth state cookies as Secure (set it in production)

# Browser origins allowed to call the API with credentials (comma-separated)
CORS_ORIGINS="http://localhost:3000"
# Parent domain shared by web and API in production (e.g. example.com),
# so the web app can read the auth cookie the API sets. Leave empty locally.
COOKIE_DOMAIN=""
# Web app origin the API sends the browser back to after an OAuth sign-in.
# Empty: the first CORS_ORIGINS entry.
WEB_URL="http://localhost:3000"

# Sign in with Google (OAuth 2.0 / OpenID Connect). Leave the placeholders to hide the button.
GOOGLE_CLIENT_ID="google-client-id-placeholder"
GOOGLE_CLIENT_SECRET="google-client-secret-placeholder"
# Must be listed exactly in the OAuth client's "Authorized redirect URIs" (Google Cloud Console)
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Sign in with GitHub (OAuth App). Leave the placeholders to hide the button.
GITHUB_CLIENT_ID="github-client-id-placeholder"
GITHUB_CLIENT_SECRET="github-client-secret-placeholder"
# Must be one of the OAuth App's "Authorization callback URL"s (GitHub → Settings → Developer settings)
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"

# Payments — PayPal (Orders API v2). Leave the placeholders to hide PayPal.
PAYPAL_CLIENT_ID="sandbox-client-id-placeholder"
PAYPAL_CLIENT_SECRET="sandbox-client-secret-placeholder"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
# Without "/checkout/return", PAYPAL_RETURN_URL is also the store URL used in emails
PAYPAL_RETURN_URL="http://localhost:3000/checkout/return"
PAYPAL_CANCEL_URL="http://localhost:3000/checkout/cancel"

# Payments — Stripe (Checkout). Leave the key as a placeholder to hide Stripe.
STRIPE_SECRET_KEY="sk_test_placeholder"
# Signing secret of the webhook endpoint (POST /api/payments/stripe/webhook)
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_SUCCESS_URL="http://localhost:3000/checkout/return"
STRIPE_CANCEL_URL="http://localhost:3000/checkout/cancel"

# Email (Resend)
RESEND_API_KEY="re_placeholder-change-me"
RESEND_FROM="onboarding@resend.dev"
APP_NAME="Atelier"
RESET_PASSWORD_URL="http://localhost:3000/reset-password"

# Storage (DigitalOcean Spaces, S3-compatible)
DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACES_REGION="nyc3"
DO_SPACES_BUCKET="my-bucket-placeholder"
DO_SPACES_KEY="do-access-key-placeholder"
DO_SPACES_SECRET="do-secret-placeholder"
# Optional CDN base for public URLs; empty uses https://<bucket>.<endpoint host>
DO_SPACES_CDN_ENDPOINT=""
