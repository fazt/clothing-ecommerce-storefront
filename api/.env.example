# ─── API de Atelier (desarrollo) ───────────────────────────────────────────────
# cp api/.env.example api/.env
# NUNCA subas el .env al repo (es público). Las claves de pago van solo en modo test/sandbox.

NODE_ENV=development
PORT=4057
# URL pública de la API (webhooks de pago) y de la web (emails, vuelta de las pasarelas, OAuth).
API_URL=http://127.0.0.1:4057
WEB_URL=http://127.0.0.1:5226
# Orígenes extra con credenciales (separados por coma). La WEB_URL siempre está permitida.
CORS_ORIGINS=
# Saltos de proxy de confianza (1 detrás de nginx en producción) para que el rate limit vea la IP real.
TRUST_PROXY=0

DATABASE_URL=postgresql://atelier:atelier@127.0.0.1:5486/atelier?schema=public

# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d
# Solo si la API vive en un subdominio hermano de la web (api.example.com ↔ example.com).
COOKIE_DOMAIN=
# Cookie Secure: vacío = solo en producción.
COOKIE_SECURE=

APP_NAME=Atelier
# Moneda de la tienda (ISO 4217). PayPal no acepta PEN/COP/CLP/ARS; Mercado Pago cobra en la moneda de su cuenta.
CURRENCY=USD
# Minutos que una orden pendiente retiene stock y cupón antes de vencer.
ORDER_RESERVATION_MINUTES=30
# Job que vence órdenes pendientes (vacío = encendido salvo en tests).
JOBS_ENABLED=
JOBS_INTERVAL_MS=60000
LOG_LEVEL=debug

# ─── Pagos ─────────────────────────────────────────────────────────────────────
# Cada pasarela aparece en el checkout SOLO si sus variables están definidas.
# Pasarela simulada: vacío = encendida en desarrollo y APAGADA en producción.
PAYMENTS_SIMULATED_ENABLED=true

# Stripe Checkout (modo test: sk_test_...). Webhook: POST {API_URL}/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#          checkout.session.async_payment_failed, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Orders v2 (sandbox). Webhook: POST {API_URL}/api/webhooks/paypal
# Eventos: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Mercado Pago Checkout Pro (credenciales TEST-...). Webhook: POST {API_URL}/api/webhooks/mercadopago
# (evento «Pagos»). La clave secreta del webhook es obligatoria en producción.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Sin clave, los emails no se envían: solo se registra el asunto en el log.
RESEND_API_KEY=
RESEND_FROM=Atelier <onboarding@resend.dev>

# ─── Login social (opcional) ───────────────────────────────────────────────────
# Cada botón aparece solo si su proveedor tiene credenciales.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:4057/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:4057/api/auth/github/callback

# ─── Imágenes ──────────────────────────────────────────────────────────────────
# local: se guardan en api/uploads y la API las sirve en /uploads. spaces: DigitalOcean Spaces (S3).
STORAGE_DRIVER=local
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN_ENDPOINT=
