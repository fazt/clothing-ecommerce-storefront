{
  "name": "ecommerce-api",
  "version": "3.0.0",
  "private": true,
  "description": "API del e-commerce Atelier: Express 5, TypeScript, Prisma 7 y PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1034.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "resend": "^6.12.2",
    "tsx": "^4.20.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
