{
  "name": "ecommerce-cli",
  "version": "1.0.0",
  "description": "CLI to operate the ecommerce API from the terminal",
  "type": "module",
  "bin": {
    "ecom": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
